# Production template — copy to .env and fill in. Never commit real values.
# Local dev defaults live in .env (git-ignored).

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/chayil_resources"

STORAGE_DRIVER="disk"
STORAGE_DIR="./storage"
# STORAGE_DRIVER="r2" for Cloudflare R2:
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_BUCKET="chayil-resources"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# R2_PUBLIC_URL="https://pub-<id>.r2.dev"

BETTER_AUTH_SECRET="generate-with: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
BETTER_AUTH_URL="https://your-domain.example.com"

# AI (optional — features degrade gracefully without it)
# GROQ_API_KEY=""
# GROQ_MODEL="openai/gpt-oss-20b"

# Email (optional — password reset links log to console without it)
# RESEND_API_KEY=""
# EMAIL_FROM="ChayilResources <noreply@your-domain.example.com>"
# PASSWORD_RESET_DEV_LOG="false"
