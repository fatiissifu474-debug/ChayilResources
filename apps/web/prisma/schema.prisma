// ChayilResources — Prisma schema
// Auth tables follow the better-auth Prisma adapter conventions.
// Curriculum taxonomy: Level -> ClassLevel -> Subject -> Strand -> SubStrand -> Topic -> Resource

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  TEACHER
  REVIEWER
  ADMIN
  PUBLISHER
  INSTITUTION_ADMIN
}

enum EducationLevel {
  PRIMARY
  JHS
  SHS
  TVET
}

enum ResourceType {
  TEXTBOOK
  TEACHER_GUIDE
  LESSON_PLAN
  SCHEME_OF_LEARNING
  WORKSHEET
  ASSESSMENT
  QUIZ
  EXAM_PREP
  CLASSROOM_ACTIVITY
  TEACHING_STRATEGY
  REVISION_MATERIAL
  STUDENT_MATERIAL
  VIDEO
  DIAGRAM
  POSTER
  PRESENTATION
  READING_MATERIAL
  PRACTICAL_ACTIVITY
  PROJECT_IDEA
  REMEDIAL
  ENRICHMENT
  OTHER
}

enum ReviewStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum FeedbackKind {
  USEFUL
  NOT_USEFUL
  APPROPRIATE
  NEEDS_IMPROVEMENT
  INCORRECT
  OUTDATED
  INAPPROPRIATE
}

// ---------- BetterAuth ----------

model User {
  id              String    @id
  name            String
  email           String
  emailVerified   Boolean
  image           String?
  createdAt       DateTime
  updatedAt       DateTime
  sessions        Session[]
  accounts        Account[]

  // ChayilResources profile fields
  role             Role     @default(TEACHER)
  profileCompleted Boolean  @default(false)
  teachingLevels   String[] @default([])
  subjects         String[] @default([])
  school           String?
  feedbacks        Feedback[]
  savedResources   SavedResource[]
  collections      Collection[]
  submittedResources Resource[] @relation("SubmittedResources")
  packsCreated     Pack[]       @relation("PackCreator")
  organization     String?      // publisher / partner organization (PRD §17)
  modulesCreated   Module[]     @relation("ModuleCreator")
  moduleProgress   ModuleProgress[]
  discussionPosts  DiscussionPost[]
  discussionReplies DiscussionReply[]
  packSuggestions  PackSuggestion[]
  pathsCreated     LearningPath[] @relation("PathCreator")
  announcementsCreated Announcement[] @relation("AnnouncementCreator")
  country          String?      // education system scope (Phase 3 expansion starter)
  notificationPreference NotificationPreference?
  entitlements     Entitlement[]
  grantedEntitlements Entitlement[] @relation("GrantedEntitlements")
  institutionMemberships InstitutionMember[]
  institutionsCreated Institution[] @relation("InstitutionCreator")
  auditActions     AuditLog[]
  viewLogs         ViewLog[]
  downloadLogs     DownloadLog[]
  searchLogs       SearchLog[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// ---------- Curriculum taxonomy ----------

model ClassLevel {
  id        String          @id @default(cuid())
  level     EducationLevel
  name      String          // e.g. "Primary 5", "JHS 2", "SHS 1", "TVET Year 1"
  position  Int             // ordering within level
  subjects  Subject[]
  topics    Topic[]
  resources Resource[]
  packs     Pack[]
  learnerLessons LearnerLesson[]
  systemId  String?
  system    EducationSystem? @relation(fields: [systemId], references: [id], onDelete: SetNull)

  @@unique([systemId, level, name])
  @@map("class_level")
}

model Subject {
  id         String          @id @default(cuid())
  name       String          // e.g. "English Language"
  code       String?
  level      EducationLevel
  classLevels ClassLevel[]
  strands    Strand[]
  topics     Topic[]
  resources  Resource[]
  packs      Pack[]
  learnerLessons LearnerLesson[]
  systemId   String?
  system     EducationSystem? @relation(fields: [systemId], references: [id], onDelete: SetNull)

  @@unique([systemId, level, name])
  @@map("subject")
}

model Strand {
  id        String      @id @default(cuid())
  name      String
  subjectId String
  subject   Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subStrands SubStrand[]

  @@unique([subjectId, name])
  @@map("strand")
}

model SubStrand {
  id       String  @id @default(cuid())
  name     String
  strandId String
  strand   Strand  @relation(fields: [strandId], references: [id], onDelete: Cascade)
  topics   Topic[]

  @@unique([strandId, name])
  @@map("sub_strand")
}

model Topic {
  id           String      @id @default(cuid())
  name         String
  objectives   String?
  subjectId    String
  subject      Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subStrandId  String?
  subStrand    SubStrand?  @relation(fields: [subStrandId], references: [id], onDelete: SetNull)
  classLevelId String?
  classLevel   ClassLevel? @relation(fields: [classLevelId], references: [id], onDelete: SetNull)
  resources    ResourceTopic[]
  learnerLessons LearnerLesson[]

  @@index([subjectId])
  @@map("topic")
}

// ---------- Resources ----------

model Resource {
  id               String        @id @default(cuid())
  title            String
  description      String
  type             ResourceType
  fileKey          String?       // storage key (null = metadata-only / link pending)
  aiSummary        String?       // cached Groq-generated summary (nullable = not yet generated)
  fileSize         Int?
  mimeType         String?
  pages            Int?
  author           String?
  publisher        String?
  edition          String?
  copyrightHolder  String        // required: copyright governance (PRD §28)
  permittedUse     String        // required: e.g. "Classroom use, no redistribution"
  reviewStatus     ReviewStatus  @default(DRAFT)
  badges           String[]      @default([]) // REVIEWED, CURRICULUM_ALIGNED, CONTRIBUTOR, RECOMMENDED
  access           AccessLevel   @default(FREE) // hybrid model (PRD §25): free vs premium
  level            EducationLevel
  classLevelId     String?
  classLevel       ClassLevel?   @relation(fields: [classLevelId], references: [id], onDelete: SetNull)
  subjectId        String?
  subject          Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topics           ResourceTopic[]
  feedbacks        Feedback[]
  savedBy          SavedResource[]
  collectionItems  CollectionItem[]
  packItems        PackItem[]
  packSuggestions  PackSuggestion[]
  viewLogs         ViewLog[]
  downloadLogs     DownloadLog[]
  submittedById    String?       // teacher/contributor who submitted (null = staff-created)
  submittedBy      User?         @relation("SubmittedResources", fields: [submittedById], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([level, classLevelId, subjectId, type])
  @@index([reviewStatus])
  @@map("resource")
}

model ResourceTopic {
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  topicId    String
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([resourceId, topicId])
  @@map("resource_topic")
}

// ---------- Lesson preparation packs (Phase 2, PRD §20) ----------
// A pack groups resources for one class/subject into a preparation flow.
// Items are auto-assembled from approved resources; the detail page slots
// them into Learn → Plan → Practice → Check sections by resource type.

model Pack {
  id           String        @id @default(cuid())
  title        String
  description  String
  objectives   String?
  level        EducationLevel
  classLevelId String?
  classLevel   ClassLevel?   @relation(fields: [classLevelId], references: [id], onDelete: SetNull)
  subjectId    String?
  subject      Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  reviewStatus ReviewStatus  @default(DRAFT)
  createdById  String
  createdBy    User          @relation("PackCreator", fields: [createdById], references: [id], onDelete: Cascade)
  items        PackItem[]
  suggestions  PackSuggestion[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([level, classLevelId, subjectId])
  @@index([reviewStatus])
  @@map("pack")
}

model PackItem {
  id         String   @id @default(cuid())
  packId     String
  pack       Pack     @relation(fields: [packId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  position   Int

  @@unique([packId, resourceId])
  @@index([packId, position])
  @@map("pack_item")
}

// ---------- Hybrid access (PRD §25) ----------
// Discovery stays open; downloads of PREMIUM resources require an entitlement:
// a personal PREMIUM grant or membership in an active INSTITUTION.

enum AccessLevel {
  FREE
  PREMIUM
}

enum EntitlementKind {
  PREMIUM
  INSTITUTIONAL
}

model Entitlement {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          EntitlementKind
  expiresAt     DateTime?       // null = no expiry
  institutionId String?
  institution   Institution?    @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  grantedById   String?
  grantedBy     User?           @relation("GrantedEntitlements", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())

  @@index([userId])
  @@map("entitlement")
}

model Institution {
  id          String              @id @default(cuid())
  name        String
  code        String              @unique // join code shared with teachers
  active      Boolean             @default(true)
  createdById String
  createdBy   User                @relation("InstitutionCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members     InstitutionMember[]
  entitlements Entitlement[]
  createdAt   DateTime            @default(now())

  @@map("institution")
}

model InstitutionMember {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([institutionId, userId])
  @@map("institution_member")
}

// ---------- Notification preferences (PRD §23) ----------

model NotificationPreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newInSubjects Boolean  @default(true)
  savedUpdates  Boolean  @default(true)
  announcements Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  @@map("notification_preference")
}

// ---------- Professional learning modules (Phase 2, PRD §22) ----------
// Short training modules: guides, tips and readings in ordered steps.
// Teachers track step progress; completion is recorded per teacher.

model Module {
  id             String         @id @default(cuid())
  slug           String         @unique
  title          String
  description    String
  objectives     String?
  durationMinutes Int?
  audience       String?
  reviewStatus   ReviewStatus   @default(DRAFT)
  createdById    String
  createdBy      User           @relation("ModuleCreator", fields: [createdById], references: [id], onDelete: Cascade)
  steps          ModuleStep[]
  pathItems      LearningPathItem[]
  progress       ModuleProgress[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([reviewStatus])
  @@map("module")
}

model ModuleStep {
  id       String @id @default(cuid())
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  position Int
  title    String
  body     String

  @@unique([moduleId, position])
  @@index([moduleId, position])
  @@map("module_step")
}

model ModuleProgress {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId      String
  module        Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  completedStep Int      @default(0) // highest completed step position (1-based); 0 = started
  completed     Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  @@unique([userId, moduleId])
  @@map("module_progress")
}

// ---------- Teacher community (Phase 3, PRD §24) ----------
// Moderated, professional discussion: teaching ideas, classroom challenges,
// resource recommendations. Staff can hide/unhide/delete; teachers can report.

model DiscussionPost {
  id        String            @id @default(cuid())
  authorId  String
  author    User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  body      String
  tag       String?           // e.g. subject or topic label
  hidden    Boolean           @default(false)
  flagged   Boolean           @default(false)
  replies   DiscussionReply[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([createdAt])
  @@map("discussion_post")
}

model DiscussionReply {
  id        String         @id @default(cuid())
  postId    String
  post      DiscussionPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  hidden    Boolean        @default(false)
  createdAt DateTime       @default(now())

  @@index([postId, createdAt])
  @@map("discussion_reply")
}

// ---------- Collaborative creation (Phase 3) ----------
// Teachers suggest library resources for lesson packs; staff approve and the
// resource joins the pack. Suggestions are tracked per teacher.

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

model PackSuggestion {
  id         String           @id @default(cuid())
  packId     String
  pack       Pack             @relation(fields: [packId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource         @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     SuggestionStatus @default(PENDING)
  createdAt  DateTime         @default(now())

  @@unique([packId, resourceId, userId])
  @@index([packId, status])
  @@map("pack_suggestion")
}

// ---------- Learning paths: advanced CPD (Phase 3, PRD §22) ----------
// Ordered module sequences (e.g. "Formative Assessment Pathway"). Progress is
// derived from per-module completion — no extra progress table needed.

model LearningPath {
  id          String            @id @default(cuid())
  slug        String            @unique
  title       String
  description String
  reviewStatus ReviewStatus     @default(DRAFT)
  createdById String
  createdBy   User              @relation("PathCreator", fields: [createdById], references: [id], onDelete: Cascade)
  items       LearningPathItem[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([reviewStatus])
  @@map("learning_path")
}

model LearningPathItem {
  id       String       @id @default(cuid())
  pathId   String
  path     LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  moduleId String
  module   Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  position Int

  @@unique([pathId, moduleId])
  @@index([pathId, position])
  @@map("learning_path_item")
}

// ---------- Announcements (completes PRD §23 preferences) ----------

model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  createdById String
  createdBy   User     @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("announcement")
}

// ---------- Learner Resources (learner-facing lessons, Basic 1-9) ----------
// Step-by-step learner books with critical-thinking activities and assessments,
// developed from teacher lesson plans. Files live beside teacher plans in git;
// metadata + reading text live here.

model LearnerLesson {
  id           String       @id @default(cuid())
  title        String
  description  String
  basicLevel   Int          // 1-9 (Basic 1-6 = Primary, 7-9 = JHS)
  classLevelId String?
  classLevel   ClassLevel?  @relation(fields: [classLevelId], references: [id], onDelete: SetNull)
  subjectId    String?
  subject      Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topicId      String?
  topic        Topic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)
  sourceRef    String?      // e.g. "Basic 7 Oral Language Lesson 3"
  bodyText     String       // full reading text for on-screen study
  fileKey      String?
  fileSize     Int?
  mimeType     String?
  reviewStatus ReviewStatus @default(DRAFT)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([basicLevel, subjectId])
  @@index([reviewStatus])
  @@map("learner_lesson")
}

// ---------- Staff audit trail (Phase 5 governance) ----------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action     String   // e.g. resource.approve, entitlement.grant, member.add
  targetType String   // resource | pack | module | path | suggestion | post | entitlement | institution | member | announcement
  targetId   String
  detail     String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_log")
}

// ---------- Education systems (Phase 3 expansion foundation) ----------
// Taxonomy roots per country/curriculum (e.g. Ghana NaCCA, Nigeria NERDC).
// Existing rows attach to the default system; browse filters by system.

model EducationSystem {
  id         String       @id @default(cuid())
  country    String       @unique
  name       String       // e.g. "Ghana NaCCA"
  active     Boolean      @default(true)
  classLevels ClassLevel[]
  subjects   Subject[]
  createdAt  DateTime     @default(now())

  @@map("education_system")
}

// ---------- Teacher engagement ----------

model Feedback {
  id         String       @id @default(cuid())
  resourceId String
  resource   Resource     @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       FeedbackKind
  comment    String?
  createdAt  DateTime     @default(now())

  @@unique([resourceId, userId, kind])
  @@map("feedback")
}

model SavedResource {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, resourceId])
  @@map("saved_resource")
}

model Collection {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  items     CollectionItem[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("collection")
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  resourceId   String
  resource     Resource   @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([collectionId, resourceId])
  @@map("collection_item")
}

// ---------- Usage metrics (PRD §33) ----------

model ViewLog {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  resourceId String
  resource   Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([resourceId])
  @@map("view_log")
}

model DownloadLog {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  resourceId String
  resource   Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([resourceId])
  @@map("download_log")
}

model SearchLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  query     String
  createdAt DateTime @default(now())

  @@index([query])
  @@map("search_log")
}
