# Copy to `.env` (same folder) and fill in. Never commit `.env`.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Postgres password for the Docker database (pick anything strong)
DB_PASSWORD=change-me-to-something-long-and-random

# App session secret (generate a fresh one — do NOT reuse the dev laptop's)
BETTER_AUTH_SECRET=generate-a-fresh-64-char-hex-value

# Groq AI key (optional — AI features degrade gracefully without it).
# Reuse your existing key from the Groq console.
GROQ_API_KEY=
